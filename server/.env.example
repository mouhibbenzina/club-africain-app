# =============================================================
# Club Africain API — configuration (copiez ce fichier en `.env`)
# =============================================================

# Réseau
HOST=0.0.0.0
PORT=3001
# URL publique vue de l'extérieur (utilisée pour les liens email)
PUBLIC_URL=https://api.votre-domaine.tn

# Environnement: development | production | test
NODE_ENV=production

# Sécurité
# IMPORTANT: générez un secret long en production, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Durée de vie des sessions (secondes), 30 jours par défaut
JWT_TTL_SECONDS=2592000

# CORS : "*" (tout) ou liste d'origines autorisées, ex: http://localhost:8081,https://app.votre-domaine.tn
CORS_ORIGIN=*
# Mettre "true" quand le serveur est derrière un reverse proxy (nginx/Caddy) pour lire les vraies IP
TRUST_PROXY=false

# Limitation de débit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=15

# Verrouillage après échecs de connexion
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Email — exigences du compte
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Mailer : "console" (démo, logge les liens) ou "smtp" (réel)
MAILER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Club Africain App <no-reply@clubafricain.tn>"

# Compte administrateur initial (créé si aucun admin n'existe)
ADMIN_EMAIL=admin@clubafricain.tn
ADMIN_PASSWORD=Changez-Moi-123

# Paiement : "mock" (démo, valide immédiatement) — intégrez un vrai
# fournisseur et renvoyez le webhook au point /payments/webhook/<provider>
PAYMENT_PROVIDER=mock
# Secret partagé vérifié sur les webhooks de paiement (conservez-le secret)
PAYMENT_WEBHOOK_SECRET=

# Sauvegardes automatiques de la base (toutes les N heures)
AUTO_BACKUP=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Taille max du corps JSON accepté
JSON_BODY_LIMIT=1mb